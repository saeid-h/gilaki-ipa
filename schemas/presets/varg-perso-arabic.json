    { "ipa": "dʒ", "out": "ج" },
    { "ipa": "ʃ", "out": "ش" },
    { "ipa": "ʒ", "out": "ژ" },
    { "ipa": "iː", "out": "ی" },
    { "ipa": "uː", "out": "ۊ" },
    { "ipa": "ə", "out": "ٚ" },
    { "ipa": "ä", "out": "أ" },
    { "ipa": "ɒ", "out": "آ" },
    { "ipa": "ɛ", "out": "ئ" },
    { "ipa": "ü", "out": "ۋ" },
    { "ipa": "i", "out": "ی" },
    { "ipa": "e", "out": "ئ" },
    { "ipa": "a", "out": "ا" },
    { "ipa": "o", "out": "ؤ" },
    { "ipa": "u", "out": "ۊ" },
    { "ipa": "p", "out": "پ" },
    { "ipa": "b", "out": "ب" },
    { "ipa": "t", "out": "ت" },
    { "ipa": "d", "out": "د" },
    { "ipa": "k", "out": "ک" },
