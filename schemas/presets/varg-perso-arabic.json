    { "ipa": "v", "out": "و" },
    { "ipa": "s", "out": "س" },
    { "ipa": "z", "out": "ز" },
    { "ipa": "x", "out": "خ" },
    { "ipa": "ɣ", "out": "غ" },
    { "ipa": "h", "out": "ه" },
    { "ipa": "m", "out": "م" },
    { "ipa": "n", "out": "ن" },
    { "ipa": "ŋ", "out": "نگ" },
    { "ipa": "l", "out": "ل" },
    { "ipa": "r", "out": "ر" },
    { "ipa": "j", "out": "ی" }
  ]
