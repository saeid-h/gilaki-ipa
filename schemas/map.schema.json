{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/map.schema.json",
  "title": "GilakiTranscriptMap",
  "type": "object",
  "required": ["id", "name", "script", "rules"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "script": {
      "type": "string",
      "enum": ["Arab", "Latn", "Cyrl", "Grek", "Zyyy"]
    },
    "direction": { "type": "string", "enum": ["rtl", "ltr"], "default": "ltr" },
    "lossy": { "type": "boolean", "default": false },
    "normalize": { "type": "string", "enum": ["NFC", "NFKC"], "default": "NFC" },
    "separator": { "type": "string", "default": "" },
    "unknown": {
      "type": "string",
      "description": "If set, replace unmapped phones with this. If omitted, keep the IPA symbol."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ipa", "out"],
        "additionalProperties": false,
        "properties": {
          "ipa": { "type": "string", "minLength": 1 },
          "out": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
